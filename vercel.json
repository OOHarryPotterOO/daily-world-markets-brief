{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
